# Скрипты для macOS/Linux обязаны иметь переводы строк LF: bash спотыкается
# о \r и падает с непонятным "command not found". Форсим независимо от того,
# на какой системе файл был отредактирован.
*.command text eol=lf
*.sh      text eol=lf
*.plist   text eol=lf
Dockerfile text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Батники, наоборот, требуют CRLF.
*.bat     text eol=crlf

*.py      text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
